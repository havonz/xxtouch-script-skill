{
    "type": "xpp",
    "bid": "xpp-script-template",
    "name": "xpp-script-template",
    "entitlements": {
        "allow-external-require": false
    },
    "ignores": [
        "/.dist",
        "/.git",
        "/xxtouch-script-guide.md",
        "/AGENTS.md",
        "/CLAUDE.md",
        "/GEMINI.md"
    ],
    "buildIgnores": [
        "/main.json",
        "/XXTLanControl.lua"
    ],
    "onEncryptSuccess": {
        "win32": "echo ${fileDirname}",
        "darwin": "echo ${fileDirname}",
        "default": "echo ${file}, ${fileDirname}, ${fileBasename}"
    }
}