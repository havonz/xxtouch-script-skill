{
    "type": "xxt",
    "bid": "xxt-script-template",
    "information": [
        [
            "Name",
            "xxt-script-template"
        ],
        [
            "Description",
            "xxt-script-template is a template for creating new xxt scripts."
        ],
        [
            "Version",
            "0.0.1"
        ]
    ],
    "name": "xxt-script-template",
    "entitlements": {
        "allow-external-require": false
    },
    "ignores": [
        "/.dist",
        "/.git",
        "/xxtouch-script-guide.md",
        "/AGENTS.md",
        "/CLAUDE.md",
        "/GEMINI.md"
    ],
    "buildIgnores": [
        "/lua/scripts/main.json",
        "/lua/XXTLanControl.lua",
        "/lua/scripts/XXTLanControl.lua"
    ],
    "onEncryptSuccess": {
        "win32": "echo ${fileDirname}",
        "darwin": "echo ${fileDirname}",
        "default": "echo ${file}, ${fileDirname}, ${fileBasename}"
    }
}